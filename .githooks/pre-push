#!/usr/bin/env bash
# pre-push hook: final defense before commits leave the machine.
#
# git invokes this with arguments (<remote-name> <remote-url>) and feeds
# <local-ref> <local-sha> <remote-ref> <remote-sha>\n lines on stdin for
# each ref being pushed.

# shellcheck source=.githooks/_lib.sh
. "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")")/_lib.sh"

remote_name="${1:-origin}"
remote_url="${2:-$(git remote get-url --push "$remote_name" 2>/dev/null || true)}"

failed=0
commit_failed=0
ident_failed=0

# The account checks (push URL, gh login, commit authors) belong to the
# maintainer's clone only; see is_maintainer_clone in _lib.sh. The trailer
# and footprint checks run for everyone who installed the hooks.
maintainer=0
if is_maintainer_clone; then
    maintainer=1
fi

# ----- Push URL check (maintainer's clone only) -----------------------------

if [ "$maintainer" -eq 1 ]; then
    bad_urls=()
    owner=""
    while IFS= read -r url; do
        [ -z "$url" ] && continue
        # Match the URL's owner segment exactly where we can parse one, so a
        # repo like "<owner>-mirror" under another account cannot pass on a
        # substring. URLs with no host (local paths) keep the looser check.
        if owner=$(push_url_owner "$url"); then
            is_allowed_owner "$owner" || bad_urls+=("$url")
        elif ! contains_allowed_identity "$url"; then
            bad_urls+=("$url")
        fi
    done < <({ printf '%s\n' "$remote_url"; collect_push_urls "$remote_name"; } | awk '!seen[$0]++')

    if [ "${#bad_urls[@]}" -gt 0 ]; then
        hook_error "push URL points to an account outside the allowlist ($(allowed_list_for_message))"
        for u in "${bad_urls[@]}"; do hook_detail "$u"; done
        hook_detail "Reset: git remote set-url --push $remote_name git@github.com:${HOOKS_ALLOW[0]}/clipman.git"
        hint_not_maintainer
        failed=1
    fi
fi

# ----- gh active account (maintainer's clone only) --------------------------
#
# gh's active account is the one 'gh pr create' uses, and the one pushing
# over https when gh is git's credential helper, so a foreign one is an
# error, not a warning.

if [ "$maintainer" -eq 1 ]; then
    active=$(gh_active_login)
    if [ -n "$active" ] && ! contains_allowed_identity "$active"; then
        hook_error "gh-CLI active account is '$active' (outside the allowlist)"
        hook_detail "Switch: gh auth switch -u ${HOOKS_ALLOW[0]}"
        failed=1
    fi
fi

# ----- Per-commit scan ----------------------------------------------------

zero=0000000000000000000000000000000000000000

scan_commit() {
    local sha="$1"
    local local_failed=0

    # Author + committer identity (maintainer's clone only). Each distinct
    # value is reported once.
    if [ "$maintainer" -eq 1 ]; then
        local ident
        while IFS= read -r ident; do
            if [ -n "$ident" ] && ! contains_allowed_identity "$ident"; then
                hook_error "commit $sha attributed to an account outside the allowlist"
                hook_detail "  $ident"
                local_failed=1
                ident_failed=1
            fi
        done < <(git log -1 --format='%ae%n%ce%n%an%n%cn' "$sha" | awk '!seen[$0]++')
    fi

    # Trailers, message and added lines: the same checks CI runs on
    # every pull request (scan_commit_content in _lib.sh).
    if ! scan_commit_content "$sha"; then
        local_failed=1
    fi

    return "$local_failed"
}

# git feeds four fields per ref; only the local sha and the remote sha
# are used, but all four must be read to consume the line.
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue  # branch deletion

    # Always scan only commits this push contributes to the remote:
    # ancestors reachable from local_sha but NOT from ANY ref on the
    # remote. This handles three cases uniformly —
    #   1. New branch off main: scans only the new commits, not main's
    #      history that's already on origin.
    #   2. Fast-forward update: scans only the new top-of-branch commits.
    #   3. Force-push after rebase / merge of main: scans only the
    #      rebased / merge commit, NOT the upstream commits pulled in
    #      from origin/main (which were already vetted when they merged).
    # The previous existing-branch path used $remote_sha..$local_sha,
    # which over-scanned in case (3): after rebasing onto an updated
    # main, every commit from main that wasn't reachable from the old
    # remote tip appeared in the range and tripped the identity check.
    commits=$(git rev-list "$local_sha" --not --remotes="$remote_name" 2>/dev/null)
    if [ -z "$commits" ] && [ "$remote_sha" = "$zero" ]; then
        # Fall back to a bounded local-only scan (last 200 commits) so a
        # brand-new remote with no refs to anchor against doesn't make
        # us iterate ALL of history.
        commits=$(git rev-list "$local_sha" --max-count=200)
    fi

    [ -z "$commits" ] && continue

    while IFS= read -r sha; do
        [ -z "$sha" ] && continue
        if ! scan_commit "$sha"; then
            failed=1
            commit_failed=1
        fi
    done <<<"$commits"
done

if [ "$ident_failed" -ne 0 ]; then
    hint_not_maintainer
fi

if [ "$failed" -ne 0 ]; then
    hook_section "push aborted"
    if [ "$commit_failed" -ne 0 ]; then
        hook_detail "To fix: amend or interactive-rebase the offending commit(s)."
    fi
    hook_detail "Bypass once (NOT recommended): git push --no-verify"
    exit 1
fi

if [ "$maintainer" -eq 1 ]; then
    hook_ok "push: identity + commits clean"
else
    hook_ok "push: commits clean (account checks are off outside the maintainer's clone)"
fi
exit 0
